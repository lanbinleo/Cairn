{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Cairn",
  "version": "0.2.3",
  "identifier": "app.cairn.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cairn",
        "width": 1168,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 720,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNEVEOUU5NTQ2QzFDMTYKUldRV0hHeFU2ZGxPdTE5VmtXb0E0M0crbnU5blZORjZLbEFQbk9ITU9CZGlqVURHODl2VFAyYmsK",
      "endpoints": [
        "https://github.com/lanbinleo/Cairn/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
